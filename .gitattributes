# Set up the line ending for text files
/mvnw text eol=lf
*.cmd text eol=crlf

# Set up the text file line ending
*.txt text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.java text eol=lf
*.sql text eol=lf

# Set up the binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
*.ear binary
*.class binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Set up the merge strategy for specific files
pom.xml merge=maven.plugin
